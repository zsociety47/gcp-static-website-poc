# Copy this file to .env and fill in the two blanks. .env is gitignored.
# Do not commit a project id you have already created, or any billing account id.
#
# A project id is 6 to 30 characters, starts with a letter, and cannot be reused
# after that project is deleted. Deletion can take up to 30 days to finish.
# If the name is taken, change it here. The scripts read this file. They do not
# fall back to whatever project gcloud is currently pointed at.

# Change zeon01 to your owner word. Project ids and bucket names must be yours.
GCP_PROJECT_ID=staticweb-poc-yourname01
GCP_BILLING_ACCOUNT=
GCP_REGION=us-east1
BUCKET_NAME=staticweb-poc-yourname01
